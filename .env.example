# ---- Satellite data credentials (optional) ---------------------------------
# The primary pipeline (Earth Search STAC / AWS open data) needs NO credentials.
# Fill these in if you also want to pull full-resolution products from the
# Copernicus Data Space catalogue, or to use CDSE-hosted COGs.

# Copernicus Data Space account (https://dataspace.copernicus.eu)
CDSE_USERNAME=
CDSE_PASSWORD=

# Machine-to-machine credentials (alternative to username/password):
# created at https://dataspace.copernicus.eu -> Profile -> Settings -> Machine to machine
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# ---- Optional ----
# Cache TTL for the OAuth token in seconds (default 3600)
CDSE_TOKEN_TTL=3600

# Directory where downloaded products and token cache live.
# Defaults to data/cache inside the project if unset.
NILE_CACHE_DIR=data/cache
